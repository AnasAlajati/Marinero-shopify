{%- doc -%}
  Renders a simple product card for the architecture section's scrollers.
  Self-contained (no block dependency) since the parent section renders products
  directly from a product_list setting rather than from section.blocks.

  @param {object} product - The product object

  @example
  {% render 'architecture-product-card', product: product %}
{%- enddoc -%}

<div class="architecture-card">
  <a href="{{ product.url }}" class="architecture-card__link">
    <div class="architecture-card__media">
      {%- if product.featured_image -%}
        {% render 'image',
          image: product.featured_image,
          class: 'architecture-card__image',
          alt_text_fallback: product.title
        %}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'architecture-card__image placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="architecture-card__info">
      <p class="architecture-card__title">{{ product.title }}</p>
      <p class="architecture-card__price">{% render 'format-price', price: product.price %}</p>

      {%- comment -%}
        Colour swatches in the list item. Baymard found 57% of sites omit these,
        forcing users onto the product page just to see what colours exist.
        Renders only when the product actually has a colour-style option.
      {%- endcomment -%}
      {%- for option in product.options_with_values -%}
        {%- assign option_name = option.name | downcase -%}
        {%- if option_name contains 'color' or option_name contains 'colour' -%}
          <ul class="architecture-card__swatches" aria-label="{{ option.name }}">
            {%- for value in option.values limit: 5 -%}
              <li
                class="architecture-card__swatch"
                style="--swatch: {{ value | handleize }};"
                title="{{ value }}"
              >
                <span class="visually-hidden">{{ value }}</span>
              </li>
            {%- endfor -%}
            {%- if option.values.size > 5 -%}
              <li class="architecture-card__swatch-more">+{{ option.values.size | minus: 5 }}</li>
            {%- endif -%}
          </ul>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </a>
</div>
