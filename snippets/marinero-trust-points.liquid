{%- doc -%}
  Reassurance points shown under the add to cart button: cash on delivery, exchange window
  and next-day dispatch. Each is set in Theme settings > Marinero delivery.
{%- enddoc -%}

{%- liquid
  assign is_ar = false
  if request.locale.iso_code == 'ar'
    assign is_ar = true
  endif
  assign exchange_days = settings.marinero_exchange_days
-%}

{%- if settings.marinero_show_cod or exchange_days != blank or settings.marinero_show_next_day_dispatch -%}
  <ul class="marinero-trust-points" role="list">
    {%- if settings.marinero_show_cod -%}
      <li class="marinero-trust-points__item">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 12h.01M18 12h.01"/></svg>
        <span>{% if is_ar %}الدفع عند الاستلام{% else %}Cash on delivery{% endif %}</span>
      </li>
    {%- endif -%}
    {%- if exchange_days != blank -%}
      <li class="marinero-trust-points__item">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 0 1 15.5-6.2L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15.5 6.2L3 16"/><path d="M3 21v-5h5"/></svg>
        <span>{% if is_ar %}استبدال خلال {{ exchange_days }} يوم{% else %}{{ exchange_days }}-day exchanges{% endif %}</span>
      </li>
    {%- endif -%}
    {%- if settings.marinero_show_next_day_dispatch -%}
      <li class="marinero-trust-points__item">
        {% render 'icon-or-image', icon: 'truck', width: 20 %}
        <span>{% if is_ar %}يُسلَّم لشركة الشحن في يوم العمل التالي{% else %}Ships next business day{% endif %}</span>
      </li>
    {%- endif -%}
  </ul>
{%- endif -%}

{% stylesheet %}
  .marinero-trust-points {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    gap: 8px;
    width: 100%;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }
  .marinero-trust-points__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 10px 6px;
    border-radius: 6px;
    background: rgb(var(--color-foreground-rgb) / 0.04);
    font-size: 0.8125rem;
    line-height: 1.3;
    text-align: center;
    color: var(--color-foreground);
  }
  .marinero-trust-points__item svg { flex-shrink: 0; }
{% endstylesheet %}
