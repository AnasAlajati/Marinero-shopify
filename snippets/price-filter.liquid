{%- doc -%}
  Renders a price filter.

  @param {object} filter - The filter object to render.
  @param {string} filter_style - The filter style, can be 'horizontal' or 'vertical'.
  @param {boolean} [should_render_clear] - Whether to render the clear button.
  @param {string} [id_prefix] - Unique prefix to avoid duplicate IDs when rendered multiple times.

  @example
  {% render 'price-filter', filter: filter, filter_style: 'vertical', id_prefix: 'dialog' %}
{%- enddoc -%}

{%- liquid
  assign is_horizontal = false
  assign is_vertical = false
  if filter_style == 'horizontal'
    assign is_horizontal = true
  elsif filter_style == 'vertical'
    assign is_vertical = true
  endif
-%}
{% capture accordion_children %}
  <details
    class="facets__panel"
    {% if filter_style == 'horizontal' %}
      data-auto-close-details="desktop"
    {% endif %}
    {% if filter_style == 'vertical' %}
      open
    {% endif %}
  >
    <summary
      class="facets__summary"
      data-testid="price-filter"
    >
      <span class="facets__label">{{ filter.label }}</span>
      <facet-status-component class="facets__status">
        <template ref="moneyFormat">{{ shop.money_format }}</template>

        <span
          class="hide-when-empty"
          ref="facetStatus"
          data-currency="{{ localization.country.currency.iso_code }}"
          data-range-max="{{ filter.range_max | money_without_currency }}"
        >
          {%- if filter.min_value.value != null or filter.max_value.value != null %}
            {%- if filter.min_value.value != null and filter.max_value.value != null %}
              {{- filter.min_value.value | money | strip_html -}}
              –
              {{- filter.max_value.value | money | strip_html -}}
            {%- elsif filter.min_value.value != null -%}
              {{ filter.min_value.value | money | strip_html }}–{{ filter.range_max | money | strip_html }}

            {%- elsif filter.max_value.value != null -%}
              {{- 0 | money | strip_html -}}
              –
              {{- filter.max_value.value | money | strip_html -}}
            {%- endif -%}
          {%- endif -%}
        </span>
      </facet-status-component>
      <span class="svg-wrapper icon-caret icon-animated">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </span>
    </summary>
    <floating-panel-component
      {% unless filter_style == 'vertical' %}
        data-close-on-resize
      {% endunless %}
      class="facets__panel-content details-content{% if filter_style == 'horizontal' %} color-{{ settings.popover_color_scheme }}{% endif %}"
    >
      {% assign min_input_max_value = filter.max_value.value | default: filter.range_max %}
      {% assign max_input_min_value = filter.min_value.value | default: 0 %}

      <price-facet-component
        class="
          price-facet
          {%- if filter_style == 'horizontal' %}
            price-facet--horizontal
          {%- endif %}
        "
        id="facet-inputs-{{ filter.param_name | escape | replace: '.', '-' }}"
        data-money-format="{{ shop.money_format | strip_html }}"
        data-currency="{{ localization.country.currency.iso_code }}"
        on:change="/updatePriceFilterAndResults"
      >
        {%- comment -%}
          The two text inputs stay in the DOM and drive the actual filtering
          (updatePriceFilterAndResults reads them by ref, validates them,
          updates the URL) — nothing about that logic changes. They're just
          visually replaced by the slider below: hidden from sighted users
          and out of the tab order/accessibility tree (aria-hidden +
          tabindex="-1"), since the range inputs become the real accessible
          controls, each with their own label. The slider writes into these
          on drag and dispatches a real 'change' event so the existing
          on:change="/updatePriceFilterAndResults" binding on this
          component fires exactly as if the customer had typed a value.
        {%- endcomment -%}
        <div class="facets__inputs-wrapper facets__inputs-wrapper--row price-facet__legacy-inputs" aria-hidden="true">
          <div
            class="price-facet__inputs-wrapper"
          >
            <div class="field price-facet__field">
              <input
                class="field__input price-facet__input"
                name="{{ filter.min_value.param_name }}"
                id="{{ filter.label | escape }}-GTE-{{ id_prefix }}"
                {%- if filter.min_value.value -%}
                  value="{{ filter.min_value.value | money_without_currency }}"
                {%- endif -%}
                type="text"
                inputmode="decimal"
                placeholder="0"
                data-min="0"
                data-max="{{ min_input_max_value | money_without_currency }}"
                ref="minInput"
                autocomplete="off"
                tabindex="-1"
              >

              <label
                class="field__label price-facet__label"
                for="{{ filter.label | escape }}-GTE-{{ id_prefix }}"
              >
                {{ cart.currency.symbol }}
              </label>
            </div>

            <div class="price-facet__separator">{{ 'fields.separator' | t }}</div>

            <div class="field price-facet__field">
              <input
                class="field__input price-facet__input"
                name="{{ filter.max_value.param_name }}"
                id="{{ filter.label | escape }}-LTE-{{ id_prefix }}"
                {%- if filter.max_value.value -%}
                  value="{{ filter.max_value.value | money_without_currency }}"
                {%- endif -%}
                type="text"
                inputmode="decimal"
                placeholder="{{ filter.range_max | money_without_currency }}"
                data-min="{{ max_input_min_value | money_without_currency }}"
                data-max="{{ filter.range_max | money_without_currency }}"
                ref="maxInput"
                autocomplete="off"
                tabindex="-1"
              >
              <label
                class="field__label price-facet__label"
                for="{{ filter.label | escape }}-LTE-{{ id_prefix }}"
              >
                {{ cart.currency.symbol }}
              </label>
            </div>
          </div>
        </div>

        {%- assign slider_min_value = filter.min_value.value | default: 0 -%}
        {%- assign slider_max_value = filter.max_value.value | default: filter.range_max -%}
        <div class="price-slider" ref="slider">
          <div class="price-slider__readout">
            <span ref="sliderReadoutMin">{{ slider_min_value | money }}</span>
            <span class="price-slider__readout-dash">–</span>
            <span ref="sliderReadoutMax">{{ slider_max_value | money }}</span>
          </div>
          <div class="price-slider__track-wrapper">
            <div class="price-slider__track"></div>
            <div class="price-slider__range" ref="sliderRange"></div>
            <input
              type="range"
              class="price-slider__input price-slider__input--min"
              min="0"
              max="{{ filter.range_max }}"
              step="1"
              value="{{ slider_min_value }}"
              ref="sliderMin"
              aria-label="{{ 'accessibility.price_filter_low' | t }}"
            >
            <input
              type="range"
              class="price-slider__input price-slider__input--max"
              min="0"
              max="{{ filter.range_max }}"
              step="1"
              value="{{ slider_max_value }}"
              ref="sliderMax"
              aria-label="{{ 'accessibility.price_filter_high' | t }}"
            >
          </div>
        </div>

        {% if filter.min_value.value != null or filter.max_value.value != null %}
          {% assign has_active_values = true %}
        {% endif %}

        {% if should_render_clear %}
          <facet-clear-component
            class="clear-filter"
            tabindex="{% if has_active_values %}0{% else %}-1{% endif %}"
            on:click="/clearFilter"
            on:keydown="/clearFilter"
          >
            <div
              class="facets__clear {% if has_active_values %}facets__clear--active{% endif %}"
              ref="clearButton"
            >
              {{- 'actions.clear' | t -}}
            </div>
          </facet-clear-component>
        {% endif %}
      </price-facet-component>
    </floating-panel-component>
  </details>
{% endcapture %}
{% render 'accordion-custom-component',
  children: accordion_children,
  class: 'facets__item',
  open: is_vertical,
  open_by_default_on_desktop: is_vertical,
  open_by_default_on_mobile: is_vertical,
  disable_animation_on_desktop: is_horizontal,
  close_with_escape: is_horizontal
%}

{% stylesheet %}
  /* Price filter */
  .price-facet {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
  }
  .price-facet--horizontal {
    min-width: 360px;
  }

  /*
    The real text inputs that drive filtering stay in the DOM (see comment
    in the markup) but are removed from view and from the a11y tree — the
    slider below is what sighted and assistive-tech users actually
    interact with.
  */
  .price-facet__legacy-inputs {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .price-slider {
    padding: var(--padding-xs) 0 var(--padding-sm);
  }

  .price-facet--horizontal .price-slider {
    padding: 0 var(--padding-md) var(--padding-xs);
    min-width: 280px;
  }

  .price-slider__readout {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--font-paragraph--size);
    margin-block-end: var(--padding-md, 1rem);
  }

  .price-slider__readout-dash {
    opacity: 0.5;
  }

  /*
    Two native range inputs stacked on the same track (the classic
    dual-handle slider technique): each input is fully transparent and
    spans the whole width, with pointer-events disabled on the track so
    clicks fall through to whichever input's thumb is actually under the
    cursor — the thumb itself re-enables pointer-events so it stays
    draggable. `.price-slider__range` is a separate div, positioned via JS
    from the two values, that paints the filled portion between the
    handles; the inputs' own (invisible) tracks paint nothing.
  */
  .price-slider__track-wrapper {
    position: relative;
    height: 20px;
  }

  .price-slider__track,
  .price-slider__range {
    position: absolute;
    top: 50%;
    height: 4px;
    transform: translateY(-50%);
    border-radius: 2px;
  }

  .price-slider__track {
    left: 0;
    right: 0;
    background: var(--color-border, #d3cebe);
  }

  .price-slider__range {
    background: var(--color-primary, #0b1f3a);
  }

  .price-slider__input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 20px;
    margin: 0;
    /*
      !important: a more specific global input rule (background:
      var(--color-input-background), which resolves to opaque white) was
      beating this plain class selector, painting a solid white bar over
      the whole track and hiding the track/range fill divs underneath it
      entirely — the reported "line looks cut off" bug.
    */
    background: transparent !important;
    border: none;
    appearance: none;
    -webkit-appearance: none;
    pointer-events: none;
  }

  .price-slider__input::-webkit-slider-runnable-track {
    -webkit-appearance: none;
    background: transparent;
  }

  .price-slider__input::-moz-range-track {
    background: transparent;
    border: none;
  }

  .price-slider__input::-webkit-slider-thumb {
    -webkit-appearance: none;
    pointer-events: auto;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--color-primary, #0b1f3a);
    border: 2px solid var(--color-background, #fff);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
    cursor: pointer;
    margin-top: -7px;
  }

  .price-slider__input::-moz-range-thumb {
    pointer-events: auto;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--color-primary, #0b1f3a);
    border: 2px solid var(--color-background, #fff);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
    cursor: pointer;
  }
{% endstylesheet %}

{% javascript %}
  if (!window.__marineroPriceSliderBound) {
    window.__marineroPriceSliderBound = true;

    // filter.range_max (and so the slider's own min/max/value) comes from
    // Shopify in minor units (cents) — the same raw value the `money`
    // filter expects, which is why the server-rendered readout needed no
    // conversion. Client-side formatting needs it explicit.
    const centsToDecimal = (cents) => cents / 100;

    const formatMoney = (cents, currency) => {
      try {
        return new Intl.NumberFormat(undefined, { style: 'currency', currency }).format(centsToDecimal(cents));
      } catch {
        return String(centsToDecimal(cents));
      }
    };

    const syncFill = (root) => {
      const sliderMin = root.querySelector('.price-slider__input--min');
      const sliderMax = root.querySelector('.price-slider__input--max');
      const range = root.querySelector('.price-slider__range');
      if (!sliderMin || !sliderMax || !range) return;

      const trackMax = Number(sliderMin.max) || 1;
      const minPercent = (Number(sliderMin.value) / trackMax) * 100;
      const maxPercent = (Number(sliderMax.value) / trackMax) * 100;
      range.style.left = minPercent + '%';
      range.style.right = 100 - maxPercent + '%';
    };

    const syncReadout = (root, currency) => {
      const sliderMin = root.querySelector('.price-slider__input--min');
      const sliderMax = root.querySelector('.price-slider__input--max');
      const readoutMin = root.querySelector('[ref="sliderReadoutMin"]');
      const readoutMax = root.querySelector('[ref="sliderReadoutMax"]');
      if (!sliderMin || !sliderMax || !readoutMin || !readoutMax) return;

      readoutMin.textContent = formatMoney(Number(sliderMin.value), currency);
      readoutMax.textContent = formatMoney(Number(sliderMax.value), currency);
    };

    const handleInput = (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement) || !target.classList.contains('price-slider__input')) return;

      const component = target.closest('price-facet-component');
      if (!component) return;

      const sliderMin = component.querySelector('.price-slider__input--min');
      const sliderMax = component.querySelector('.price-slider__input--max');

      // Keep the two handles from crossing over each other.
      if (Number(sliderMin.value) > Number(sliderMax.value)) {
        if (target === sliderMin) sliderMin.value = sliderMax.value;
        else sliderMax.value = sliderMin.value;
      }

      syncFill(component);
      syncReadout(component, component.dataset.currency || 'USD');
    };

    const handleChange = (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement) || !target.classList.contains('price-slider__input')) return;

      const component = target.closest('price-facet-component');
      if (!component) return;

      const minInput = component.querySelector('[ref="minInput"]');
      const maxInput = component.querySelector('[ref="maxInput"]');
      const sliderMin = component.querySelector('.price-slider__input--min');
      const sliderMax = component.querySelector('.price-slider__input--max');
      if (!minInput || !maxInput || !sliderMin || !sliderMax) return;

      // The legacy inputs expect a plain decimal amount (what a customer
      // would type, e.g. "1859.99"), not the slider's raw minor-unit value.
      minInput.value = centsToDecimal(Number(sliderMin.value));
      maxInput.value = centsToDecimal(Number(sliderMax.value));
      // Bubbles up to price-facet-component's own on:change binding, which
      // runs the theme's existing validation + AJAX filter update — the
      // same path a typed value would take.
      minInput.dispatchEvent(new Event('change', { bubbles: true }));
    };

    document.addEventListener('input', handleInput);
    document.addEventListener('change', handleChange);

    document.querySelectorAll('price-facet-component').forEach((component) => {
      syncFill(component);
      syncReadout(component, component.dataset.currency || 'USD');
    });
  }
{% endjavascript %}
