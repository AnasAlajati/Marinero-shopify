{%- comment -%}
  Social proof / reviews.

  Built around the Spiegel Research Center findings:
  - 5 reviews is the threshold where purchase likelihood jumps (~270% vs zero);
    marginal benefit falls off sharply after that, so aim for 5 per product.
  - Purchase probability peaks at 4.0-4.7 stars and DECLINES toward 5.0, because
    perfect scores read as fake. Don't hide mildly critical reviews.
  - Verified-buyer badges add roughly 15%.

  MOCK DATA: the review blocks below are samples. Replace with real customer
  reviews. If you later install a reviews app, keep this section for the
  homepage summary and let the app own the product pages.
{%- endcomment -%}

{%- liquid
  assign total = 0
  for block in section.blocks
    assign total = total | plus: block.settings.rating
  endfor
  assign average = 0
  if section.blocks.size > 0
    assign average = total | times: 1.0 | divided_by: section.blocks.size
  endif
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="reviews section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="
    padding-block-start: {{ section.settings.padding-block-start }}px;
    padding-block-end: {{ section.settings.padding-block-end }}px;
  "
>
  <div class="reviews__header">
    {%- if section.settings.heading != blank -%}
      <h2 class="reviews__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.show_summary and section.blocks.size > 0 -%}
      <div class="reviews__summary">
        <span class="reviews__stars" aria-hidden="true">
          {%- for i in (1..5) -%}
            <svg class="reviews__star{% if i > average %} reviews__star--empty{% endif %}" viewBox="0 0 20 20" width="18" height="18">
              <path d="M10 1.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8L1.6 7.7l5.8-.8z" />
            </svg>
          {%- endfor -%}
        </span>
        <span class="reviews__average">{{ average | round: 1 }}</span>
        <span class="reviews__count">
          {{ section.settings.count_label | replace: '[count]', section.blocks.size }}
        </span>
      </div>
    {%- endif -%}
  </div>

  <reviews-scroller class="reviews__scroller">
  <div class="reviews__grid" tabindex="0" aria-label="{{ section.settings.heading | escape }}">
    {%- for block in section.blocks -%}
      <figure class="review-card" {{ block.shopify_attributes }}>
        <span class="reviews__stars review-card__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
          {%- for i in (1..5) -%}
            <svg class="reviews__star{% if i > block.settings.rating %} reviews__star--empty{% endif %}" viewBox="0 0 20 20" width="15" height="15" aria-hidden="true">
              <path d="M10 1.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8L1.6 7.7l5.8-.8z" />
            </svg>
          {%- endfor -%}
        </span>

        {%- comment -%}
          dir="auto" lets the browser pick RTL/LTR per-card from the text's
          own first strong-direction character, since reviews are a mix of
          Arabic and English rather than a single fixed direction.
        {%- endcomment -%}
        <blockquote class="review-card__text" dir="auto">{{ block.settings.text }}</blockquote>

        <figcaption class="review-card__meta">
          <span class="review-card__author" dir="auto">{{ block.settings.author }}</span>
          {%- if block.settings.verified -%}
            <span class="review-card__verified">
              <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
                <path d="M6.2 11.4L3.4 8.6l1.1-1.1 1.7 1.7 4.3-4.3 1.1 1.1z" />
              </svg>
              {{ section.settings.verified_label }}
            </span>
          {%- endif -%}
          {%- if block.settings.context != blank -%}
            <span class="review-card__context">{{ block.settings.context }}</span>
          {%- endif -%}
        </figcaption>
      </figure>
    {%- endfor -%}
  </div>
  <div class="reviews__dots" hidden></div>
  </reviews-scroller>
</div>

{% javascript %}
  if (!customElements.get('reviews-scroller')) {
    customElements.define(
      'reviews-scroller',
      class extends HTMLElement {
        connectedCallback() {
          this.grid = this.querySelector('.reviews__grid');
          this.dots = this.querySelector('.reviews__dots');
          if (!this.grid || !this.dots) return;
          this.cards = [...this.grid.children];
          this.pageCount = 0;

          this.update = this.update.bind(this);
          this.grid.addEventListener('scroll', this.update, { passive: true });
          this.resizeObserver = new ResizeObserver(this.update);
          this.resizeObserver.observe(this.grid);

          this.dots.addEventListener('click', (event) => {
            const dot = event.target.closest('button');
            if (dot) this.goToPage(Number(dot.dataset.page));
          });

          this.setUpMouseDrag();
        }

        disconnectedCallback() {
          this.resizeObserver?.disconnect();
        }

        // Touch swiping is native; this adds the same click-and-drag swipe for mouse users.
        setUpMouseDrag() {
          let startX = 0;
          let startScroll = 0;
          let dragging = false;

          this.grid.addEventListener('pointerdown', (event) => {
            if (event.pointerType !== 'mouse' || event.button !== 0) return;
            dragging = true;
            startX = event.clientX;
            startScroll = this.grid.scrollLeft;
            this.grid.setPointerCapture(event.pointerId);
            this.grid.classList.add('is-dragging');
          });

          this.grid.addEventListener('pointermove', (event) => {
            if (!dragging) return;
            this.grid.scrollLeft = startScroll - (event.clientX - startX);
          });

          const end = () => {
            if (!dragging) return;
            dragging = false;
            this.grid.classList.remove('is-dragging');
            this.scrollToCard(Math.round(Math.abs(this.grid.scrollLeft) / this.cardStep));
          };
          this.grid.addEventListener('pointerup', end);
          this.grid.addEventListener('pointercancel', end);
        }

        get cardStep() {
          if (this.cards.length < 2) return this.grid.clientWidth || 1;
          return Math.abs(this.cards[1].offsetLeft - this.cards[0].offsetLeft) || 1;
        }

        get perView() {
          return Math.max(1, Math.round((this.grid.clientWidth + this.gap) / this.cardStep));
        }

        get gap() {
          return parseFloat(getComputedStyle(this.grid).columnGap) || 0;
        }

        scrollToCard(index) {
          const card = this.cards[Math.min(Math.max(index, 0), this.cards.length - 1)];
          if (!card) return;
          const direction = getComputedStyle(this.grid).direction === 'rtl' ? -1 : 1;
          this.grid.scrollTo({
            left: direction * Math.abs(card.offsetLeft - this.cards[0].offsetLeft),
            behavior: 'smooth',
          });
        }

        goToPage(page) {
          this.scrollToCard(page * this.perView);
        }

        update() {
          const max = this.grid.scrollWidth - this.grid.clientWidth;
          const pageCount = max > 1 ? Math.ceil(this.cards.length / this.perView) : 0;
          this.dots.hidden = pageCount < 2;

          if (pageCount !== this.pageCount) {
            this.pageCount = pageCount;
            this.dots.replaceChildren(
              ...Array.from({ length: pageCount }, (_, page) => {
                const dot = document.createElement('button');
                dot.type = 'button';
                dot.className = 'reviews__dot';
                dot.dataset.page = page;
                dot.setAttribute('aria-label', `Show reviews ${page + 1} of ${pageCount}`);
                return dot;
              })
            );
          }
          if (pageCount < 2) return;

          const scrolled = Math.abs(this.grid.scrollLeft);
          const active =
            scrolled >= max - 2
              ? pageCount - 1
              : Math.min(pageCount - 1, Math.round(scrolled / this.cardStep / this.perView));
          [...this.dots.children].forEach((dot, page) => {
            dot.setAttribute('aria-current', page === active ? 'true' : 'false');
          });
        }
      }
    );
  }
{% endjavascript %}

{% stylesheet %}
  .reviews {
    row-gap: var(--space-md, 2rem);
    align-content: start;
  }

  .reviews__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs, 0.5rem);
    text-align: center;
  }

  .reviews__heading {
    margin: 0;
  }

  .reviews__summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
  }

  .reviews__stars {
    display: inline-flex;
    gap: 0.1rem;
  }

  .reviews__star {
    fill: currentColor;
  }

  .reviews__star--empty {
    opacity: 0.22;
  }

  .reviews__average {
    font-weight: 600;
  }

  .reviews__count {
    opacity: 0.7;
  }

  .reviews__scroller {
    --reviews-per-view: 2;
    --reviews-gap: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
  }

  @media screen and (min-width: 750px) {
    .reviews__scroller {
      --reviews-per-view: 3;
      --reviews-gap: 1.25rem;
    }
  }

  @media screen and (min-width: 1600px) {
    .reviews__scroller {
      --reviews-per-view: 4;
    }
  }

  /* Padding offset by negative margin keeps card borders and shadows from being clipped by overflow-x. */
  .reviews__grid {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0.75rem;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    gap: var(--reviews-gap);
    padding: 0.75rem;
    margin: -0.75rem;
    cursor: grab;
  }

  .reviews__grid.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    user-select: none;
  }

  .reviews__grid::-webkit-scrollbar {
    display: none;
  }

  .reviews__grid:focus-visible {
    outline: 2px solid rgb(var(--color-foreground-rgb) / 0.5);
    outline-offset: 4px;
    border-radius: 16px;
  }

  .review-card {
    flex: 0 0
      calc((100% - (var(--reviews-per-view) - 1) * var(--reviews-gap)) / var(--reviews-per-view));
    min-width: 0;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin: 0;
    padding: 1rem;
    background: #fff;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
    border-radius: 14px;
    box-shadow: 0 4px 18px rgb(11 31 58 / 0.07);
  }

  @media screen and (min-width: 750px) {
    .review-card {
      gap: 0.75rem;
      padding: 1.5rem;
      border-radius: 16px;
    }
  }

  .reviews__dots {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
  }

  .reviews__dots[hidden] {
    display: none;
  }

  /* 24px hit area around an 8px dot. */
  .reviews__dot {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .reviews__dot::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: rgb(var(--color-foreground-rgb) / 0.2);
    transition: width 0.25s ease, background-color 0.25s ease;
  }

  .reviews__dot[aria-current='true']::before {
    width: 20px;
    background: rgb(var(--color-foreground-rgb) / 0.8);
  }

  .reviews__dot:focus-visible {
    outline: 2px solid rgb(var(--color-foreground-rgb) / 0.5);
    border-radius: 999px;
  }

  .review-card__text {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.55;
  }

  @media screen and (min-width: 750px) {
    .review-card__text {
      font-size: 0.92rem;
    }
  }

  .review-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    margin-top: auto;
  }

  .review-card__author {
    font-weight: 600;
  }

  .review-card__verified {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    opacity: 0.8;
  }

  .review-card__verified svg {
    fill: currentColor;
  }

  .review-card__context {
    opacity: 0.6;
  }

{% endstylesheet %}

{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "METADATA: replace the sample reviews with real ones. Research note: aim for 5 reviews per product (the jump in purchase likelihood happens there), and keep the average between 4.0-4.7 — near-perfect 5.0 averages reduce purchase probability because shoppers assume they're fake."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What parents say"
    },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "Show average rating summary",
      "default": true
    },
    {
      "type": "text",
      "id": "count_label",
      "label": "Count label",
      "default": "based on [count] reviews",
      "info": "Use [count] where the number should appear."
    },
    {
      "type": "text",
      "id": "verified_label",
      "label": "Verified badge text",
      "default": "Verified buyer"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review text",
          "default": "MOCK REVIEW — replace with a real customer review."
        },
        { "type": "text", "id": "author", "label": "Author", "default": "Customer name" },
        {
          "type": "text",
          "id": "context",
          "label": "Context",
          "info": "e.g. \"Bought 6-7 Years\" — size context in reviews is unusually persuasive in kids' apparel."
        },
        { "type": "checkbox", "id": "verified", "label": "Verified buyer", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "text": "MOCK REVIEW — replace. The quality is much better than I expected for the price, and the sizing chart was accurate for my son.",
            "author": "Customer name",
            "context": "Bought 6-7 Years",
            "verified": true
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 4,
            "text": "MOCK REVIEW — replace. Lovely fabric and it washed well. Slightly long on the sleeves but she grew into it quickly.",
            "author": "Customer name",
            "context": "Bought 10-12 Years",
            "verified": true
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "text": "MOCK REVIEW — replace. Delivery was quick and paying on delivery made it easy. Ordering again for my other son.",
            "author": "Customer name",
            "context": "Bought 4-5 Years",
            "verified": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
