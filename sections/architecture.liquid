{%- comment -%}
  Block-free hero/scroller section. All configuration lives in section settings:
  - Banner: image_desktop / image_mobile / image_overlay / heading / text / text_banner
  - Primary scroller: products (product_list) + cards_scroll_direction
  - Secondary list: products_additionaly (product_list) + heading_additional / subheading_additional / link_additional(_label)
  - Spacing: offset_top_desktop / offset_bottom_desktop / offset_top_mobile / offset_bottom_mobile
{%- endcomment -%}

{% liquid
  assign scroll_direction = section.settings.cards_scroll_direction
  assign has_secondary = false
  if section.settings.products_additionaly.size > 0
    assign has_secondary = true
  endif
%}

{% javascript %}
  class ArchitectureScrollPin extends HTMLElement {
    connectedCallback() {
      this.track = this.querySelector('[data-architecture-track]');
      this.viewport = this.querySelector('[data-architecture-viewport]');
      if (!this.track || !this.viewport) return;

      this.reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      this.mobileQuery = window.matchMedia('(max-width: 749px)');
      this.maxTranslate = 0;
      this.rafId = null;

      this.measure = this.measure.bind(this);
      this.onScroll = this.onScroll.bind(this);

      this.resizeObserver = new ResizeObserver(this.measure);
      this.resizeObserver.observe(this.track);
      this.resizeObserver.observe(this.viewport);

      this.reducedMotionQuery.addEventListener('change', this.measure);
      this.mobileQuery.addEventListener('change', this.measure);
      window.addEventListener('scroll', this.onScroll, { passive: true });

      this.measure();
    }

    disconnectedCallback() {
      window.removeEventListener('scroll', this.onScroll);
      this.reducedMotionQuery?.removeEventListener('change', this.measure);
      this.mobileQuery?.removeEventListener('change', this.measure);
      this.resizeObserver?.disconnect();
      if (this.rafId !== null) cancelAnimationFrame(this.rafId);
    }

    measure() {
      const allowed = !this.reducedMotionQuery.matches && !this.mobileQuery.matches;

      this.maxTranslate = allowed
        ? Math.max(0, this.track.scrollWidth - this.viewport.clientWidth)
        : 0;

      // Only pin when the track actually overflows. Pinning with zero travel
      // would steal a full viewport height of scrolling and move nothing.
      this.enabled = allowed && this.maxTranslate > 0;

      if (!this.enabled) {
        this.removeAttribute('data-pinned');
        this.style.height = '';
        this.track.style.transform = '';
        return;
      }

      this.setAttribute('data-pinned', '');
      this.style.height = `${this.viewport.offsetHeight + this.maxTranslate}px`;
      this.update();
    }

    onScroll() {
      if (this.rafId !== null) return;
      this.rafId = requestAnimationFrame(() => {
        this.rafId = null;
        this.update();
      });
    }

    update() {
      if (!this.enabled) return;

      const scrollable = this.offsetHeight - this.viewport.offsetHeight;
      if (scrollable <= 0) return;

      const rect = this.getBoundingClientRect();
      const progress = Math.min(1, Math.max(0, -rect.top / scrollable));

      this.track.style.transform = `translate3d(-${progress * this.maxTranslate}px, 0, 0)`;
    }
  }

  if (!customElements.get('architecture-scroll-pin')) {
    customElements.define('architecture-scroll-pin', ArchitectureScrollPin);
  }
{% endjavascript %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="architecture-section color-{{ section.settings.color_scheme }} section"
  style="
    padding-top: {{ section.settings.offset_top_desktop }}px;
    padding-bottom: {{ section.settings.offset_bottom_desktop }}px;
    --architecture-offset-top-mobile: {{ section.settings.offset_top_mobile }}px;
    --architecture-offset-bottom-mobile: {{ section.settings.offset_bottom_mobile }}px;
  "
>
  {%- liquid
    assign has_banner_image = false
    if section.settings.image_desktop != blank or section.settings.image_mobile != blank
      assign has_banner_image = true
    endif
  -%}

  {%- if has_banner_image -%}
    {%- comment -%}
      Full hero treatment: reserves min-height for the photo. Only rendered
      when an image is actually set, so an unconfigured banner never shows as
      a tall block of dead space.
    {%- endcomment -%}
    <div class="architecture-banner">
      <div class="architecture-banner__media">
        {%- if section.settings.image_desktop != blank -%}
          {% render 'image',
            image: section.settings.image_desktop,
            class: 'architecture-banner__image architecture-banner__image--desktop'
          %}
        {%- endif -%}

        {%- if section.settings.image_mobile != blank -%}
          {% render 'image',
            image: section.settings.image_mobile,
            class: 'architecture-banner__image architecture-banner__image--mobile'
          %}
        {%- elsif section.settings.image_desktop != blank -%}
          {% render 'image',
            image: section.settings.image_desktop,
            class: 'architecture-banner__image architecture-banner__image--mobile'
          %}
        {%- endif -%}

        <div class="architecture-banner__overlay" style="background: {{ section.settings.image_overlay }};"></div>
      </div>

      {%- if section.settings.heading != blank or section.settings.text != blank -%}
        <div class="architecture-banner__content" style="color: {{ section.settings.text_banner }};">
          {%- if section.settings.heading != blank -%}
            <h2 class="architecture-banner__heading">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="architecture-banner__text">{{ section.settings.text }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  {%- elsif section.settings.heading != blank or section.settings.text != blank -%}
    {%- comment -%}
      No image set: a compact text-only header with no reserved height,
      instead of an empty 420px hero box.
    {%- endcomment -%}
    <div class="architecture-header">
      {%- if section.settings.heading != blank -%}
        <h2 class="architecture-header__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="architecture-header__text">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- liquid
    assign has_teaser = false
    if section.settings.teaser_heading != blank or section.settings.teaser_image != blank
      assign has_teaser = true
    endif
  -%}

  {%- capture teaser_card -%}
    {%- if has_teaser -%}
      <article class="architecture-card architecture-teaser-card">
        {%- if section.settings.teaser_link != blank -%}
          <a href="{{ section.settings.teaser_link }}" class="architecture-teaser-card__link">
        {%- else -%}
          <div class="architecture-teaser-card__link">
        {%- endif -%}
          <div class="architecture-teaser-card__media">
            {%- if section.settings.teaser_image != blank -%}
              {% render 'image', image: section.settings.teaser_image, class: 'architecture-teaser-card__image' %}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'architecture-teaser-card__image' }}
            {%- endif -%}
            <div class="architecture-teaser-card__overlay"></div>
          </div>
          <p class="architecture-teaser-card__heading">{{ section.settings.teaser_heading }}</p>
        {%- if section.settings.teaser_link != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
      </article>
    {%- endif -%}
  {%- endcapture -%}

  {%- if section.settings.products.size > 0 -%}
    {%- if scroll_direction == 'vertical' -%}
      <div class="architecture-scroller architecture-scroller--vertical">
        {{ teaser_card }}
        {%- for product in section.settings.products -%}
          {% render 'architecture-product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      {%- comment -%}
        Vertical page scroll drives horizontal movement of the track while this
        element is pinned (position: sticky) in the viewport. See the
        architecture-scroll-pin custom element above.
      {%- endcomment -%}
      <architecture-scroll-pin class="architecture-scroll-pin">
        <div class="architecture-pin-viewport" data-architecture-viewport>
          <div class="architecture-scroller architecture-scroller--horizonta" data-architecture-track>
            {{ teaser_card }}
            {%- for product in section.settings.products -%}
              {% render 'architecture-product-card', product: product %}
            {%- endfor -%}
          </div>
        </div>
      </architecture-scroll-pin>
    {%- endif -%}
  {%- endif -%}

  {%- if has_secondary -%}
    <div class="architecture-secondary">
      {%- if section.settings.heading_additional != blank or section.settings.subheading_additional != blank or section.settings.link_additional != blank -%}
        <div class="architecture-secondary__header">
          <div class="architecture-secondary__heading-group">
            {%- if section.settings.heading_additional != blank -%}
              <h3 class="architecture-secondary__heading">{{ section.settings.heading_additional }}</h3>
            {%- endif -%}
            {%- if section.settings.subheading_additional != blank -%}
              <p class="architecture-secondary__subheading">{{ section.settings.subheading_additional }}</p>
            {%- endif -%}
          </div>
          {%- if section.settings.link_additional != blank -%}
            <a href="{{ section.settings.link_additional }}" class="architecture-secondary__link">
              {{ section.settings.link_additional_label | default: section.settings.link_additional }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="architecture-scroller architecture-scroller--horizonta">
        {%- for product in section.settings.products_additionaly -%}
          {% render 'architecture-product-card', product: product %}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  /*
    `.section` is a 3-column grid (margin | content | margin) and auto-places
    children into the centre column. Setting `display` here would collapse that
    and push content to the viewport edges.
  */
  .architecture-section {
    row-gap: var(--padding-xl, 48px);
    align-content: start;
  }

  .architecture-banner {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    min-height: 420px;
    border-radius: var(--corner-radius, 0);
  }

  .architecture-banner__media {
    position: absolute;
    inset: 0;
  }

  .architecture-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .architecture-banner__image--mobile {
    display: none;
  }

  .architecture-banner__overlay {
    position: absolute;
    inset: 0;
  }

  .architecture-banner__content {
    position: relative;
    z-index: 1;
    padding: var(--padding-xl, 48px);
    max-width: 40em;
  }

  .architecture-banner__heading {
    margin: 0 0 var(--padding-sm, 12px);
  }

  .architecture-banner__text {
    margin: 0;
  }

  /* Compact fallback used when no banner image is set — see comment above. */
  .architecture-header {
    display: flex;
    flex-direction: column;
    gap: var(--padding-2xs, 4px);
  }

  .architecture-header__heading {
    margin: 0;
  }

  .architecture-header__text {
    margin: 0;
    opacity: 0.75;
  }

  .architecture-scroller {
    display: flex;
    gap: var(--padding-md, 16px);
  }

  .architecture-scroller--horizonta {
    overflow-x: auto;
    overflow-y: hidden;
    flex-direction: row;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }

  /*
    Card width is deliberately identical pinned and unpinned. The JS measures
    the track to decide whether to pin, so if pinning changed card widths the
    measurement would flip-flop and the ResizeObserver would oscillate.
    These also need to be wide enough that a handful of products overflow the
    container — otherwise there is no horizontal distance to travel.
  */
  .architecture-scroller--horizonta .architecture-card {
    flex: 0 0 auto;
    /* 30% smaller than the original clamp(260px, 32vw, 460px). */
    width: clamp(182px, 22vw, 322px);
    scroll-snap-align: start;
  }

  .architecture-scroller--vertical {
    overflow-y: auto;
    overflow-x: hidden;
    flex-direction: column;
    max-height: 640px;
  }

  .architecture-scroller--vertical .architecture-card {
    width: 100%;
  }

  /*
    Default state (no JS, or JS disabled it via measure()): behave like a
    plain swipeable horizontal strip so the section still works without the
    pinned scroll-jack effect.
  */
  .architecture-pin-viewport {
    display: flex;
  }

  /*
    Pinned state: the custom element is given an explicit height (viewport
    height + horizontal distance to travel) so that scrolling through it
    keeps .architecture-pin-viewport stuck to the top of the screen while
    .architecture-scroller--horizonta is translated sideways by JS.
  */
  .architecture-scroll-pin[data-pinned] {
    display: block;
  }

  .architecture-scroll-pin[data-pinned] .architecture-pin-viewport {
    position: sticky;
    top: 0;
    height: 100vh;
    align-items: center;
    overflow: hidden;
  }

  .architecture-scroll-pin[data-pinned] .architecture-scroller--horizonta {
    overflow: visible;
    flex-wrap: nowrap;
    will-change: transform;
  }

  .architecture-card__link {
    display: flex;
    flex-direction: column;
    gap: var(--padding-2xs, 4px);
    text-decoration: none;
    color: inherit;
  }

  .architecture-card__media {
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .architecture-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /*
      These product photos have a lot of empty space below the model's feet,
      so a centered crop (the default) cuts into the head before it runs out
      of blank floor to trim. Anchoring near the top keeps the head in frame
      and crops the empty space at the bottom instead.
    */
    object-position: center 12%;
  }

  .architecture-card__title,
  .architecture-card__price {
    margin: 0;
  }

  /* Matches the swatch size used on collection grid cards (.collection-swatches__item) for consistency across the site. */
  .architecture-card__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .architecture-card__swatch {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--swatch, #ccc);
    border: 1px solid color-mix(in srgb, var(--color-foreground, #2c2c2a) 25%, transparent);
  }

  .architecture-card__swatch-more {
    font-size: 0.7rem;
    line-height: 16px;
    opacity: 0.65;
  }

  /*
    Teaser card: same footprint as .architecture-card (it lives in the same
    flex row and is sized by that rule), but renders as a single clickable
    image with a heading overlaid on top, rather than an image + title + price
    stack.
  */
  .architecture-teaser-card {
    /* Don't stretch to match the taller image+title+price product cards. */
    align-self: flex-start;
  }

  .architecture-teaser-card__link {
    display: block;
    position: relative;
    text-decoration: none;
    color: inherit;
  }

  .architecture-teaser-card__media {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .architecture-teaser-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow, 600ms) var(--ease-out, ease);
  }

  .architecture-teaser-card__link:hover .architecture-teaser-card__image {
    transform: scale(1.04);
  }

  .architecture-teaser-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0) 55%);
    pointer-events: none;
  }

  .architecture-teaser-card__heading {
    position: absolute;
    z-index: 1;
    left: var(--padding-sm, 12px);
    right: var(--padding-sm, 12px);
    bottom: var(--padding-sm, 12px);
    margin: 0;
    color: #fff;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .architecture-secondary {
    display: flex;
    flex-direction: column;
    gap: var(--padding-md, 16px);
  }

  .architecture-secondary__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--padding-md, 16px);
  }

  .architecture-secondary__heading,
  .architecture-secondary__subheading {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .architecture-section {
      padding-top: var(--architecture-offset-top-mobile) !important;
      padding-bottom: var(--architecture-offset-bottom-mobile) !important;
    }

    .architecture-banner__image--desktop {
      display: none;
    }

    .architecture-banner__image--mobile {
      display: block;
    }

    .architecture-scroller--horizonta .architecture-card {
      /* 30% smaller than the original 72vw. */
      width: 50vw;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Architecture",
  "class": "ui-test-architecture",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Banner"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image"
    },
    {
      "type": "color_background",
      "id": "image_overlay",
      "label": "Image overlay",
      "default": "rgba(0, 0, 0, 0.4)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the collection"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "text_banner",
      "label": "Banner text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Primary product scroller"
    },
    {
      "type": "paragraph",
      "content": "The teaser card below appears first in the scroller, sized to match a product card."
    },
    {
      "type": "image_picker",
      "id": "teaser_image",
      "label": "Teaser image"
    },
    {
      "type": "text",
      "id": "teaser_heading",
      "label": "Teaser heading",
      "default": "4-8 Years Collection"
    },
    {
      "type": "url",
      "id": "teaser_link",
      "label": "Teaser link"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products"
    },
    {
      "type": "select",
      "id": "cards_scroll_direction",
      "label": "Scroll direction",
      "options": [
        {
          "value": "horizonta",
          "label": "Horizontal"
        },
        {
          "value": "vertical",
          "label": "Vertical"
        }
      ],
      "default": "horizonta"
    },
    {
      "type": "header",
      "content": "Secondary product list"
    },
    {
      "type": "product_list",
      "id": "products_additionaly",
      "label": "Additional products"
    },
    {
      "type": "text",
      "id": "heading_additional",
      "label": "Additional heading"
    },
    {
      "type": "text",
      "id": "subheading_additional",
      "label": "Additional subheading"
    },
    {
      "type": "text",
      "id": "link_additional_label",
      "label": "Additional link label"
    },
    {
      "type": "url",
      "id": "link_additional",
      "label": "Additional link"
    },
    {
      "type": "header",
      "content": "Color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "offset_top_desktop",
      "label": "Top offset (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "offset_bottom_desktop",
      "label": "Bottom offset (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "offset_top_mobile",
      "label": "Top offset (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "offset_bottom_mobile",
      "label": "Bottom offset (mobile)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Architecture",
      "settings": {
        "heading": "Shop the collection",
        "teaser_heading": "4-8 Years Collection",
        "cards_scroll_direction": "horizonta",
        "color_scheme": "scheme-1",
        "offset_top_desktop": 48,
        "offset_bottom_desktop": 48,
        "offset_top_mobile": 24,
        "offset_bottom_mobile": 24
      }
    }
  ]
}
{% endschema %}
