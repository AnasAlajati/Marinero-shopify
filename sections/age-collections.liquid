{%- comment -%}
  Age / category routing grid.

  This is the primary navigation element for a kids' store: the first question
  a parent has is "what fits my child's age?". Baymard's product-list research
  is clear that routing should be visual and immediate rather than buried in a
  menu. Configured via blocks so you can run 3 age tiles, 6 (age x gender), or
  any mix, without code changes.

  MOCK DATA: every tile falls back to a Shopify placeholder image and sample
  copy until you set a real image and link in the theme editor.
{%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  id="AgeCollections-{{ section.id }}"
  class="age-collections section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="
    --age-columns: {{ section.settings.columns }};
    --age-ratio: {{ section.settings.image_ratio }};
    padding-block-start: {{ section.settings.padding-block-start }}px;
    padding-block-end: {{ section.settings.padding-block-end }}px;
  "
>
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="age-collections__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="age-collections__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="age-collections__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="age-collections__grid">
    {%- for block in section.blocks -%}
      <article class="age-tile" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="age-tile__link">
        {%- else -%}
          <div class="age-tile__link age-tile__link--inert">
        {%- endif -%}
          <div class="age-tile__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag: class: 'age-tile__image', loading: 'lazy', alt: block.settings.label
              }}
            {%- else -%}
              {%- capture ph -%}lifestyle-{% cycle 1, 2 %}{%- endcapture -%}
              {{ ph | placeholder_svg_tag: 'age-tile__image age-tile__image--placeholder' }}
            {%- endif -%}
            <div class="age-tile__scrim"></div>
          </div>

          <div class="age-tile__content">
            {%- if block.settings.eyebrow != blank -%}
              <p class="age-tile__eyebrow">{{ block.settings.eyebrow }}</p>
            {%- endif -%}
            <p class="age-tile__label">{{ block.settings.label }}</p>
            {%- if block.settings.sublabel != blank -%}
              <p class="age-tile__sublabel">{{ block.settings.sublabel }}</p>
            {%- endif -%}
          </div>
        {%- if block.settings.link != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
      </article>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="age-collections__dots" role="tablist" aria-label="Age groups" aria-hidden="true">
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="age-collections__dot{% if forloop.first %} age-collections__dot--active{% endif %}"
          data-index="{{ forloop.index0 }}"
          aria-label="Go to {{ block.settings.label }}"
          tabindex="-1"
        ></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{%- if section.blocks.size > 1 -%}
  <script>
  (function() {
    function initDots(sectionId) {
      const root = document.getElementById('AgeCollections-' + sectionId);
      if (!root) return;

      const grid = root.querySelector('.age-collections__grid');
      const dots = root.querySelectorAll('.age-collections__dot');
      if (!grid || !dots.length) return;

      function setActive() {
        const cards = grid.querySelectorAll('.age-tile');
        if (!cards.length) return;
        // Nearest card to the scroll container's left edge is the "active" one.
        let closest = 0;
        let closestDist = Infinity;
        cards.forEach((card, i) => {
          const dist = Math.abs(card.offsetLeft - grid.scrollLeft);
          if (dist < closestDist) {
            closestDist = dist;
            closest = i;
          }
        });
        dots.forEach((d, i) => d.classList.toggle('age-collections__dot--active', i === closest));
      }

      let ticking = false;
      grid.addEventListener('scroll', () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          setActive();
          ticking = false;
        });
      }, { passive: true });

      dots.forEach(dot => {
        dot.addEventListener('click', () => {
          const cards = grid.querySelectorAll('.age-tile');
          const target = cards[parseInt(dot.dataset.index, 10)];
          if (target) grid.scrollTo({ left: target.offsetLeft, behavior: 'smooth' });
        });
      });
    }

    initDots('{{ section.id }}');
  })();
  </script>
{%- endif -%}

{% stylesheet %}
  /* `.section` is a 3-col grid; never override its `display` here. */
  .age-collections {
    row-gap: var(--space-md, 2rem);
    align-content: start;
  }

  .age-collections__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs, 0.5rem);
    text-align: center;
    align-items: center;
  }

  .age-collections__heading {
    margin: 0;
  }

  .age-collections__subheading {
    margin: 0;
    opacity: 0.75;
    max-width: 46ch;
  }

  .age-collections__grid {
    display: grid;
    grid-template-columns: repeat(var(--age-columns, 3), minmax(0, 1fr));
    gap: var(--space-sm, 1rem);
  }

  .age-tile__link {
    display: block;
    position: relative;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    border-radius: var(--corner-radius, 0);
  }

  .age-tile__link--inert {
    cursor: default;
  }

  .age-tile__media {
    position: relative;
    aspect-ratio: var(--age-ratio, 3 / 4);
    overflow: hidden;
  }

  .age-tile__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow, 600ms) var(--ease-out, ease);
  }

  .age-tile__image--placeholder {
    background: color-mix(in srgb, var(--color-foreground, #2c2c2a) 8%, transparent);
  }

  .age-tile__link:not(.age-tile__link--inert):hover .age-tile__image {
    transform: scale(1.04);
  }

  .age-tile__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0) 60%);
    pointer-events: none;
  }

  .age-tile__content {
    position: absolute;
    z-index: 1;
    inset-inline: var(--space-sm, 1rem);
    bottom: var(--space-sm, 1rem);
    color: #fff;
  }

  .age-tile__eyebrow {
    margin: 0 0 0.25rem;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .age-tile__label {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.15;
  }

  .age-tile__sublabel {
    margin: 0.25rem 0 0;
    font-size: 0.85rem;
    opacity: 0.85;
  }

  /* Dot indicators: only meaningful for the mobile carousel (hidden below). */
  .age-collections__dots {
    display: none;
  }

  @media screen and (max-width: 749px) {
    /*
      Swipeable horizontal row instead of a stacked grid: keeps each tile's
      photo large enough to stay legible (a 3-across grid would crop them to
      slivers) while still letting all tiles live within one screen's worth
      of vertical space. Bleeds to the viewport edge so the next card peeks
      in and signals swipeability; scroll-padding keeps snapped cards
      aligned with the heading text above.
    */
    .age-collections__grid {
      grid-column: 1 / -1;
      display: flex;
      grid-template-columns: none;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      gap: 0.75rem;
      padding-inline: var(--util-page-margin-offset, 1.25rem);
      scroll-padding-inline: var(--util-page-margin-offset, 1.25rem);
      /*
        Fades the trailing edge of whichever card is peeking in, reinforcing
        that it's a cut-off preview rather than a deliberately narrow tile.
      */
      -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 28px), transparent 100%);
      mask-image: linear-gradient(to right, #000 calc(100% - 28px), transparent 100%);
    }

    .age-collections__grid::-webkit-scrollbar {
      display: none;
    }

    .age-tile {
      flex: 0 0 78%;
      scroll-snap-align: start;
    }

    .age-tile__label {
      font-size: 1.2rem;
    }

    /* Pagination dots make the swipeability explicit and show progress. */
    .age-collections__dots {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.5rem;
    }

    .age-collections__dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      border: none;
      padding: 0;
      background: color-mix(in srgb, var(--color-foreground, #2c2c2a) 25%, transparent);
      cursor: pointer;
      transition: background 0.3s ease, width 0.3s ease, border-radius 0.3s ease;
    }

    .age-collections__dot--active {
      background: var(--color-foreground, #2c2c2a);
      width: 22px;
      border-radius: 4px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Age collections",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Primary routing for a kids' store. Add one block per age group (and per gender if you split them). Replace each tile's image and link once your collections exist."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by age"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "MOCK COPY — replace with your own. Every piece is sized to fit, with height guidance on each product."
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Tile shape",
      "options": [
        { "value": "3 / 4", "label": "Portrait" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 3", "label": "Landscape" }
      ],
      "default": "3 / 4"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Collection tile",
      "settings": [
        {
          "type": "paragraph",
          "content": "METADATA: set Image + Link once the collection exists in Shopify."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "info": "Small label above the title, e.g. BOYS or GIRLS."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Title",
          "default": "4-8 Years"
        },
        {
          "type": "text",
          "id": "sublabel",
          "label": "Subtitle",
          "info": "Use this for height guidance, e.g. 104-130cm. Sizing clarity is the single biggest conversion lever in kids' apparel."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Age collections",
      "blocks": [
        { "type": "tile", "settings": { "label": "4-8 Years", "sublabel": "104-130cm", "link": "shopify://collections/all" } },
        { "type": "tile", "settings": { "label": "10-14 Years", "sublabel": "140-164cm", "link": "shopify://collections/all" } },
        { "type": "tile", "settings": { "label": "16-18 Years", "sublabel": "170-182cm", "link": "shopify://collections/all" } }
      ]
    }
  ]
}
{% endschema %}
