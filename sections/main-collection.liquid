

<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% javascript %}
  const url = new URL(window.location.href);
  if (url.hash) {
    document.addEventListener(
      'DOMContentLoaded',
      () => {
        const card = document.getElementById(url.hash.slice(1));
        if (card) {
          card.scrollIntoView({ behavior: 'instant' });
        }
      },
      { once: true }
    );
  }
{% endjavascript %}

{% comment %} We always render this full-width, as the child blocks have width: page/full settings {% endcomment %}
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<results-list
  class="section product-grid-container color-{{ section.settings.color_scheme }}"
  style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
  section-id="{{ section.id }}"
  infinite-scroll="{{ section.settings.enable_infinite_scroll }}"
>
  {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

  {% render 'marinero-gender-toggle', collection: collection %}

  <div
    class="collection-wrapper grid gap-style{% if section.settings.product_grid_width == 'full-width' %} collection-wrapper--grid-full-width{% endif %}"
  >
    {% content_for 'block',
      type: 'filters',
      id: 'filters',
      results: collection,
      results_size: collection.products_count
    %}

    {% assign products_per_page = 24 %}

    {% if section.settings.enable_infinite_scroll == false %}
      {% assign products_per_page = section.settings.products_per_page %}
    {% endif %}

    {%- liquid
      # Age grouping only activates on collections that actually use the
      # 4-8 / 10-14 / 16-18 Years tags, so every other collection keeps
      # rendering as a plain flat grid exactly as before.
      assign enable_age_grouping = false
      for filter in collection.filters
        if filter.type == 'list'
          for value in filter.values
            case value.label
              when '4-8 Years', '10-14 Years', '16-18 Years'
                assign enable_age_grouping = true
            endcase
          endfor
        endif
      endfor
    -%}

    {% paginate collection.products by products_per_page %}
      {% capture children %}
        {% if enable_age_grouping %}
          {%- assign age_groups = '4-8 Years,10-14 Years,16-18 Years' | split: ',' -%}
          {%- for age_tag in age_groups -%}
            {% capture bucket_items %}
              {% for product in collection.products %}
                {% if product.tags contains age_tag %}
                  <li
                    id="{{ section.id }}-{{ product.id }}"
                    class="product-grid__item product-grid__item--{{ forloop.index0 }}"
                    data-page="{{ paginate.current_page }}"
                    data-product-id="{{ product.id }}"
                    ref="cards[]"
                  >
                    {% # theme-check-disable %}
                    {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: product %}
                    {% # theme-check-enable %}
                  </li>
                {% endif %}
              {% endfor %}
            {% endcapture %}
            {%- assign bucket_items = bucket_items | strip -%}
            {%- if bucket_items != blank -%}
              {%- liquid
                assign age_collection = blank
                case age_tag
                  when '4-8 Years'
                    assign age_collection = collections['4-8-years']
                  when '10-14 Years'
                    assign age_collection = collections['10-14']
                  when '16-18 Years'
                    assign age_collection = collections['16-18-years']
                endcase
              -%}
              <li class="product-grid__age-heading">
                <h2 class="product-grid__age-heading-title">{{ age_tag }}</h2>
                {%- if age_collection != blank -%}
                  <a href="{{ age_collection.url }}" class="product-grid__age-heading-link">
                    View all {{ age_tag }} &rarr;
                  </a>
                {%- endif -%}
              </li>
              {{ bucket_items }}
            {%- endif -%}
          {%- endfor -%}

          {% comment %} Safety net: products with none of the three known age tags still show, rather than silently vanishing, so an untagged product is obvious instead of hidden. {% endcomment %}
          {% capture undefined_items %}
            {% for product in collection.products %}
              {% unless product.tags contains '4-8 Years' or product.tags contains '10-14 Years' or product.tags contains '16-18 Years' %}
                <li
                  id="{{ section.id }}-{{ product.id }}"
                  class="product-grid__item product-grid__item--{{ forloop.index0 }}"
                  data-page="{{ paginate.current_page }}"
                  data-product-id="{{ product.id }}"
                  ref="cards[]"
                >
                  {% # theme-check-disable %}
                  {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: product %}
                  {% # theme-check-enable %}
                </li>
              {% endunless %}
            {% endfor %}
          {% endcapture %}
          {%- assign undefined_items = undefined_items | strip -%}
          {%- if undefined_items != blank -%}
            <li class="product-grid__age-heading product-grid__age-heading--undefined">
              <h2 class="product-grid__age-heading-title">Age group not set</h2>
            </li>
            {{ undefined_items }}
          {%- endif -%}
        {% else %}
          {% for product in collection.products %}
            <li
              id="{{ section.id }}-{{ product.id }}"
              class="product-grid__item product-grid__item--{{ forloop.index0 }}"
              data-page="{{ paginate.current_page }}"
              data-product-id="{{ product.id }}"
              ref="cards[]"
            >
              {% # theme-check-disable %}
              {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: product %}
              {% # theme-check-enable %}
            </li>
          {% endfor %}
        {% endif %}
      {% endcapture %}

      {% render 'product-grid',
        section: section,
        children: children,
        products: collection.products,
        paginate: paginate,
        enable_infinite_scroll: section.settings.enable_infinite_scroll
      %}
    {% endpaginate %}
  </div>
</results-list>

{% stylesheet %}
  /*
    Same fix as the other product photo grids on the site: these photos have
    a lot of empty space below the model's feet, so the theme's default
    centered crop cuts into the head before it runs out of blank floor to
    trim. Scoped to this section's own wrapper so it only affects collection
    pages, not search results (which share the same product-grid snippet).
  */
  .product-grid-container .product-media-container img {
    object-position: center 12%;
  }

  /*
    Same legacy bug as the hero: a global rule (.section-wrapper {
    padding-block: 7rem }) stacks an extra 112px of top/bottom padding on
    top of every section's own configured padding. The collection heading
    banner already has its own 48px/48px set via its normal admin settings
    (applied on an inner element) — this legacy layer just adds ~224px of
    pure dead space around it. Targets specifically whichever section sits
    directly before this product grid (the heading banner), not
    .section-wrapper sections generally elsewhere on the site.
  */
  .shopify-section.section-wrapper:has(+ .shopify-section .product-grid-container) {
    padding-block: 0 !important;
  }

  /* Full-bleed age-group heading row inside the product grid (a CSS grid). */
  .product-grid__age-heading {
    grid-column: 1 / -1;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding-block: 1.5rem 1rem;
    border-block-start: 1px solid var(--color-border, #d3cebe);
  }

  .product-grid__age-heading:first-child {
    border-block-start: none;
    padding-block-start: 0;
  }

  .product-grid__age-heading-title {
    margin: 0;
    font-family: 'Inter', Arial, sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
  }

  .product-grid__age-heading-link {
    font-family: 'Inter', Arial, sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-foreground, #2c2c2a);
    opacity: 0.75;
    text-decoration: none;
    white-space: nowrap;
  }

  .product-grid__age-heading-link:hover {
    opacity: 1;
    text-decoration: underline;
  }

  .product-grid__age-heading--undefined .product-grid__age-heading-title {
    opacity: 0.6;
    font-style: italic;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.collection_container",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "organic",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "t:settings.auto_load_products",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24,
      "visible_if": "{{ section.settings.enable_infinite_scroll == false }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": []
}
{% endschema %}
