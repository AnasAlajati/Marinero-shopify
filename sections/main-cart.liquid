

{% capture cart_page_more_blocks_content %}
  <div class="cart-page__more-blocks">
    {%- content_for 'blocks' -%}
  </div>
{% endcapture %}

{% capture cart_items_children %}
  <template id="empty-cart-template">
    <div class="section-background color-{{ section.settings.color_scheme }}"></div>
    <div
      class="section color-{{ section.settings.color_scheme }} section--{{ section.settings.section_width }}"
    >
      <div
        class="cart-page spacing-style{% if cart.empty? %} cart-page--empty{% endif %}"
        style="{% render 'spacing-style', settings: section.settings %}"
      >
        <div class="cart-page__title">
          {%- content_for 'block', id: 'cart-page-title', type: '_cart-title', force_empty: true %}
        </div>
        <div class="cart-page__items">
          {%- content_for 'block', id: 'cart-page-items', type: '_cart-products', force_empty: true %}
        </div>
        {{ cart_page_more_blocks_content }}
      </div>
    </div>
  </template>

  {% # theme-check-disable UniqueStaticBlockId %}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <div
    class="section color-{{ section.settings.color_scheme }} section--{{ section.settings.section_width }}"
  >
    <div
      class="cart-page spacing-style{% if cart.empty? %} cart-page--empty{% endif %}"
      style="{% render 'spacing-style', settings: section.settings %}"
    >
      <div class="cart-page__title">
        {%- content_for 'block', id: 'cart-page-title', type: '_cart-title' %}
      </div>

      {%- unless cart.empty? -%}
        {%- comment -%}
          Free-shipping progress bar. This was previously hardcoded to a 500
          threshold and always on, which committed the store to a free-delivery
          promise. It is now opt-in and configurable, and off by default.
        {%- endcomment -%}
        {%- if section.settings.show_shipping_bar and section.settings.shipping_threshold > 0 -%}
          {%- liquid
            assign free_shipping_threshold = section.settings.shipping_threshold | times: 100
            assign cart_total = cart.total_price
            assign remaining = free_shipping_threshold | minus: cart_total
            assign progress = cart_total | times: 100 | divided_by: free_shipping_threshold
            if progress > 100
              assign progress = 100
            endif
          -%}
          <div class="marinero-shipping-bar">
            {%- if remaining > 0 -%}
              {%- assign remaining_money = remaining | money -%}
              <p class="marinero-shipping-bar__msg">
                {{ section.settings.shipping_bar_remaining | replace: '[amount]', remaining_money }}
              </p>
            {%- else -%}
              <p class="marinero-shipping-bar__msg marinero-shipping-bar__msg--done">
                {{ section.settings.shipping_bar_reached }}
              </p>
            {%- endif -%}
            <div class="marinero-shipping-bar__track">
              <div class="marinero-shipping-bar__fill" style="width: {{ progress }}%;"></div>
            </div>
          </div>
        {%- endif -%}

        {%- comment -%}
          Cost transparency. 23% of shoppers abandon solely because they weren't
          given an upfront estimate of total cost, and "extra costs" is the
          single largest abandonment cause (48%). This states the delivery
          position without promising a date or a free-delivery threshold.
        {%- endcomment -%}
        {%- if section.settings.delivery_note != blank -%}
          <p class="marinero-cart-note">
            <span class="marinero-cart-note__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16">
                <path d="M3 6h11v9H3zM14 9h4l3 3v3h-7z" fill="none" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="7" cy="17" r="1.7" fill="none" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="17.5" cy="17" r="1.7" fill="none" stroke="currentColor" stroke-width="1.5"/>
              </svg>
            </span>
            {{ section.settings.delivery_note }}
          </p>
        {%- endif -%}
      {%- else -%}
        <div class="marinero-empty-cart">
          <div class="marinero-empty-cart__icon" aria-hidden="true">🛒</div>
          <h2 class="marinero-empty-cart__heading">سلتك فاضية</h2>
          <p class="marinero-empty-cart__text">ما زلتِ لم تضيفي أي منتج. تصفحي مجموعتنا وأضيفي ما يعجبك لأطفالك.</p>
          <a href="{{ routes.all_products_collection_url }}" class="button button--primary marinero-empty-cart__cta">تسوقي الآن</a>
        </div>
      {%- endunless -%}

      <div class="cart-page__items">
        {%- content_for 'block', id: 'cart-page-items', type: '_cart-products' %}
      </div>

      {%- unless cart.empty? -%}
        <div class="cart-page__summary">
          {%- content_for 'block', id: 'cart-page-summary', type: '_cart-summary' -%}
        </div>
      {%- endunless -%}

      {{ cart_page_more_blocks_content }}
    </div>
  </div>
  {% # theme-check-enable UniqueStaticBlockId %}
{% endcapture %}
{% render 'cart-items-component', children: cart_items_children, section_id: section.id %}

{% stylesheet %}
  .cart-page {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 var(--padding-5xl);
  }

  .cart-page--empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .cart-page--empty .cart-page__title,
  .cart-page--empty .cart-page__more-blocks {
    margin-top: var(--margin-6xl);
  }

  /* Centered items shrink-wrap to content, so without a cap the suggestions row's full width pushes the page sideways on mobile. */
  .cart-page--empty .cart-page__items {
    max-width: 100%;
  }

  .cart-page__more-blocks {
    width: 100%;
  }

  .cart-page--empty .cart-title {
    text-align: center;
  }

  .cart-page__main {
    grid-column: 1;
  }

  .cart-page__summary {
    padding-top: var(--padding-xl);
  }

  .cart-page__title + .cart-page__items {
    margin-block-start: var(--margin-lg);
  }

  @media screen and (min-width: 750px) {
    .cart-page {
      grid-template-columns: 1fr min(50vw, var(--sidebar-width));
      grid-template-rows: min-content min-content 1fr;
    }

    .cart-page__summary {
      display: grid;
      height: 100%;
      grid-column: 2;
      grid-row: 1 / -1;
      align-self: stretch;
      grid-template-rows: subgrid;
      padding-top: 0;

      /* needed to support blurred effect from hero section */
      position: relative;
    }

    .section--page-width .cart-page:has(.cart-summary--extend) {
      grid-column: 2 / 4;
      grid-template-columns: 1fr minmax(
          var(--sidebar-width),
          calc((100vw - var(--page-width)) / 2 + var(--sidebar-width))
        );
    }
  }

  @media screen and (min-width: 1400px) {
    .cart-page {
      grid-template-columns: 1fr var(--sidebar-width);
    }
  }

  /* ── MARINERO shipping bar ── */
  .marinero-shipping-bar {
    background: #F5F0E8;
    border: 1px solid #D3CEBE;
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    grid-column: 1 / -1;
  }

  /* Delivery cost line — states the cost, promises no date. */
  .marinero-cart-note {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    font-size: 0.82rem;
    opacity: 0.85;
  }

  .marinero-cart-note__icon {
    line-height: 0;
    flex: 0 0 auto;
  }

  .marinero-shipping-bar__msg {
    font-family: 'Inter', Arial, sans-serif;
    font-size: 0.82rem;
    color: #2C2C2A;
    margin-bottom: 0.6rem;
    direction: rtl;
    text-align: right;
  }

  .marinero-shipping-bar__msg--done {
    color: #0B1F3A;
    font-weight: 600;
  }

  .marinero-shipping-bar__track {
    height: 4px;
    background: #D3CEBE;
    border-radius: 0;
    overflow: hidden;
  }

  .marinero-shipping-bar__fill {
    height: 100%;
    background: #0B1F3A;
    transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* ── MARINERO empty cart ── */
  .marinero-empty-cart {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 3rem 1.5rem;
    gap: 1rem;
    grid-column: 1 / -1;
  }

  .marinero-empty-cart__icon { font-size: 3rem; }

  .marinero-empty-cart__heading {
    font-family: 'EB Garamond', Georgia, serif;
    font-size: 1.8rem;
    font-weight: 700;
    color: #0B1F3A;
    direction: rtl;
  }

  .marinero-empty-cart__text {
    font-family: 'Inter', Arial, sans-serif;
    font-size: 0.9rem;
    color: #2C2C2A;
    max-width: 36ch;
    line-height: 1.6;
    direction: rtl;
  }

  .marinero-empty-cart__cta {
    margin-top: 0.5rem;
    padding: 0.85rem 2.5rem;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.cart",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Delivery & cost transparency"
    },
    {
      "type": "paragraph",
      "content": "23% of shoppers abandon an order solely because they weren't shown an upfront estimate of total cost, and unexpected extra costs are the single biggest cause of cart abandonment (48%). Stating your delivery cost here removes that surprise. MOCK COPY — replace."
    },
    {
      "type": "text",
      "id": "delivery_note",
      "label": "Delivery note",
      "info": "Shown above the cart items. Leave empty to hide. Avoid promising dates you can't guarantee.",
      "default": "MOCK COPY — replace with your delivery cost"
    },
    {
      "type": "checkbox",
      "id": "show_shipping_bar",
      "label": "Show free-delivery progress bar",
      "info": "Off by default. Only turn this on if you are committed to offering free delivery above the threshold.",
      "default": false
    },
    {
      "type": "number",
      "id": "shipping_threshold",
      "label": "Free delivery threshold",
      "info": "In store currency, e.g. 500.",
      "default": 500
    },
    {
      "type": "text",
      "id": "shipping_bar_remaining",
      "label": "Message below threshold",
      "info": "Use [amount] for the remaining amount.",
      "default": "أضيفي [amount] للحصول على شحن مجاني"
    },
    {
      "type": "text",
      "id": "shipping_bar_reached",
      "label": "Message at threshold",
      "default": "مبروك! حصلتِ على شحن مجاني"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
