{%- doc -%}
  Sizing helper for the product page, shown at the point of size selection.

  Baymard's apparel research found 82% of sites fail to provide adequate sizing
  information, and 90% of apparel sites fail to let users assess size or fit —
  it's the most common cause of product abandonment in clothing. Sizing shown
  next to the selector (rather than hidden in a modal) is the fix.

  Rows are configured here rather than read from the product because Shopify
  option values are usually bare numbers ("6", "8"). This maps each of those to
  an age range and body measurements without renaming variants.

  MOCK DATA: every row below is a sample. Replace with your real measurements.
{%- enddoc -%}

{%- comment -%}
  Split on newlines via newline_to_br: a literal newline inside a quoted string
  can't be used here, because each line of a {% liquid %} tag is parsed as its
  own statement.
{%- endcomment -%}
{%- assign row_list = block.settings.size_rows | strip | newline_to_br | split: '<br />' -%}

<div class="size-fit-helper" {{ block.shopify_attributes }}>
  <details class="size-fit-helper__details"{% if block.settings.open_by_default %} open{% endif %}>
    <summary class="size-fit-helper__summary">
      <span class="size-fit-helper__summary-label">
        {%- if block.settings.icon -%}
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <rect x="2.5" y="8.5" width="19" height="7" rx="1" fill="none" stroke="currentColor" stroke-width="1.5"/>
            <path d="M7 8.5v3M12 8.5v4M17 8.5v3" fill="none" stroke="currentColor" stroke-width="1.5"/>
          </svg>
        {%- endif -%}
        {{ block.settings.heading }}
      </span>
      <span class="size-fit-helper__chevron" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="14" height="14">
          <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8"/>
        </svg>
      </span>
    </summary>

    <div class="size-fit-helper__body">
      {%- if block.settings.intro != blank -%}
        <p class="size-fit-helper__intro">{{ block.settings.intro }}</p>
      {%- endif -%}

      {%- if row_list.size > 0 -%}
        <table class="size-fit-helper__table">
          <thead>
            <tr>
              <th scope="col">{{ block.settings.col_1 }}</th>
              <th scope="col">{{ block.settings.col_2 }}</th>
              <th scope="col">{{ block.settings.col_3 }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for row in row_list -%}
              {%- assign cells = row | split: '|' -%}
              {%- if cells.size > 1 -%}
                <tr data-age="{{ cells[1] | strip | escape }}">
                  <th scope="row">{{ cells[0] | strip }}</th>
                  <td>{{ cells[1] | strip }}</td>
                  <td>{{ cells[2] | strip }}</td>
                </tr>
              {%- endif -%}
            {%- endfor -%}
          </tbody>
        </table>
      {%- endif -%}

      {%- if block.settings.note != blank -%}
        <p class="size-fit-helper__note">{{ block.settings.note }}</p>
      {%- endif -%}
    </div>
  </details>

  {%- comment -%}
    Kept outside the collapsed guide so it's visible at the moment of choosing a size.
  {%- endcomment -%}
  {%- if block.settings.show_whatsapp_help -%}
    {%- liquid
      if request.locale.iso_code == 'ar'
        assign wa_help_message = 'مرحبًا! محتاج مساعدة في اختيار المقاس لـ ' | append: product.title | append: '. طول ابني/بنتي: __ سم'
      else
        assign wa_help_message = "Hi! I need help choosing a size for " | append: product.title | append: ". My child's height is __ cm"
      endif
    -%}
    {%- capture wa_help_url -%}{% render 'whatsapp-url', message: wa_help_message %}{%- endcapture -%}
    {%- assign wa_help_url = wa_help_url | strip -%}
    {%- if wa_help_url != blank -%}
      <a class="size-fit-helper__whatsapp" href="{{ wa_help_url }}" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413A11.815 11.815 0 0012.05 0zm5.422 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
        </svg>
        <span>
          {%- if request.locale.iso_code == 'ar' -%}
            مش متأكد من المقاس؟ <strong>كلمنا على واتساب</strong>
          {%- else -%}
            Not sure about the size? <strong>Message us on WhatsApp</strong>
          {%- endif -%}
        </span>
      </a>
    {%- endif -%}
  {%- endif -%}
</div>

{%- comment -%}
  Highlights the size chart row matching the customer's currently selected
  size when the guide is opened, fading after 2s, and re-highlights
  instantly if they change size while it's open. Matches by prefix (the
  selected size's value, e.g. "4-5", against each row's age text, e.g.
  "4-5 Years") rather than needing an exact match, and simply ignores any
  currently-selected value that doesn't match a row (e.g. a Color
  selection), so it degrades gracefully.
{%- endcomment -%}
<script>
  if (!window.__marineroSizeFitHighlightBound) {
    window.__marineroSizeFitHighlightBound = true;

    const HIGHLIGHT_MS = 2000;
    const timers = new WeakMap();

    function highlightMatchingRow(details) {
      if (!details.open) return;

      const table = details.querySelector('.size-fit-helper__table');
      if (!table) return;

      const checkedInputs = document.querySelectorAll(
        'variant-picker input:checked, fieldset input:checked'
      );

      let matchedRow = null;
      for (const input of checkedInputs) {
        const value = (input.value || '').trim().toLowerCase();
        if (!value) continue;

        for (const row of table.querySelectorAll('tr[data-age]')) {
          const age = (row.dataset.age || '').trim().toLowerCase();
          if (age && age.startsWith(value)) {
            matchedRow = row;
            break;
          }
        }
        if (matchedRow) break;
      }

      for (const row of table.querySelectorAll('.size-fit-helper__row--highlight')) {
        row.classList.remove('size-fit-helper__row--highlight');
      }

      if (!matchedRow) return;

      const existingTimer = timers.get(table);
      if (existingTimer) clearTimeout(existingTimer);

      matchedRow.classList.add('size-fit-helper__row--highlight');
      matchedRow.scrollIntoView({ block: 'nearest' });

      timers.set(
        table,
        setTimeout(() => {
          matchedRow.classList.remove('size-fit-helper__row--highlight');
        }, HIGHLIGHT_MS)
      );
    }

    function initSizeFitHighlight() {
      const detailsList = document.querySelectorAll('.size-fit-helper__details');

      detailsList.forEach((details) => {
        details.addEventListener('toggle', () => highlightMatchingRow(details));
        if (details.open) highlightMatchingRow(details);
      });

      document.addEventListener('variant:selected', () => {
        detailsList.forEach((details) => highlightMatchingRow(details));
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSizeFitHighlight);
    } else {
      initSizeFitHighlight();
    }
  }
</script>

{% stylesheet %}
  .size-fit-helper {
    width: 100%;
  }

  .size-fit-helper__whatsapp {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-block-start: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .size-fit-helper__whatsapp svg {
    flex-shrink: 0;
    color: #25d366;
  }

  .size-fit-helper__whatsapp strong {
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .size-fit-helper__details {
    border-block: 1px solid color-mix(in srgb, var(--color-foreground, #2c2c2a) 15%, transparent);
  }

  .size-fit-helper__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-block: 0.8rem;
    cursor: pointer;
    list-style: none;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .size-fit-helper__summary::-webkit-details-marker {
    display: none;
  }

  .size-fit-helper__summary-label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .size-fit-helper__chevron {
    line-height: 0;
    transition: transform var(--duration-normal, 320ms) var(--ease-out, ease);
  }

  .size-fit-helper__details[open] .size-fit-helper__chevron {
    transform: rotate(180deg);
  }

  .size-fit-helper__body {
    padding-block-end: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .size-fit-helper__intro,
  .size-fit-helper__note {
    margin: 0;
    font-size: 0.8rem;
    opacity: 0.75;
    line-height: 1.5;
  }

  .size-fit-helper__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
  }

  .size-fit-helper__table :is(th, td) {
    text-align: left;
    padding: 0.5rem 0.6rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-foreground, #2c2c2a) 10%, transparent);
  }

  .size-fit-helper__table thead th {
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.65;
  }

  .size-fit-helper__table tbody tr:last-child :is(th, td) {
    border-bottom: 0;
  }

  .size-fit-helper__table tbody th {
    font-weight: 600;
    white-space: nowrap;
  }

  .size-fit-helper__table tbody tr {
    background: transparent;
    transition: background-color 400ms ease;
  }

  .size-fit-helper__table tbody tr.size-fit-helper__row--highlight {
    background: color-mix(in srgb, #1c3b5b 12%, transparent);
    transition: background-color 150ms ease;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Size & fit helper",
  "settings": [
    {
      "type": "paragraph",
      "content": "MOCK DATA — replace the rows with your real measurements. 82% of apparel sites fail to give adequate sizing info, and sizing uncertainty is the most common cause of clothing abandonment, so accuracy here directly affects revenue and refused COD deliveries."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Size guide — find the right age"
    },
    {
      "type": "checkbox",
      "id": "icon",
      "label": "Show ruler icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open by default",
      "info": "Open is better for conversion (sizing info is visible without a click), closed keeps the page shorter.",
      "default": false
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "MOCK COPY — replace. Sizes are based on the child's body measurements, not the garment. Between sizes? Size up."
    },
    {
      "type": "header",
      "content": "Table"
    },
    { "type": "text", "id": "col_1", "label": "Column 1 heading", "default": "Size" },
    { "type": "text", "id": "col_2", "label": "Column 2 heading", "default": "Age" },
    { "type": "text", "id": "col_3", "label": "Column 3 heading", "default": "Height (cm)" },
    {
      "type": "textarea",
      "id": "size_rows",
      "label": "Rows",
      "info": "One row per line, columns separated by | . Example:  6 | 6-7 Years | 116-122",
      "default": "4 | 4-5 Years | 98-112\n6 | 6-7 Years | 113-124\n8 | 8-9 Years | 125-134\n10 | 10-11 Years | 135-146\n12 | 12-13 Years | 147-158\n14 | 14-15 Years | 159-168\n16 | 16-17 Years | 169-174\n18 | 18-19 Years | 175-186"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Note",
      "default": "MOCK COPY — replace. Not sure which size? Message us with your child's height and we'll recommend one."
    },
    {
      "type": "checkbox",
      "id": "show_whatsapp_help",
      "label": "Show WhatsApp size help link",
      "info": "Uses the number in Theme settings > WhatsApp button.",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Size & fit helper"
    }
  ]
}
{% endschema %}
